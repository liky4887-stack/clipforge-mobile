{
  "expo": {
    "name": "ClipForge",
    "slug": "clipforge-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clipforge",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-secure-store",
      "expo-video",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save edited videos to your gallery"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
